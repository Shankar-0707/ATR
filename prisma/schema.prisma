// AI Task Runner — database schema (see extracted_requirements.txt §4)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE")
}

model User {
  id              String           @id @default(uuid()) @db.Uuid
  email           String           @unique
  password        String
  plan            String           @default("free") // "free" | "pro" | "admin"
  created_at      DateTime         @default(now()) @db.Timestamptz(6)
  queues          Queue[]
  jobs            Job[]
  usageDaily      UsageDaily[]
  upgradeRequests UpgradeRequest[]
}

model UpgradeRequest {
  id          String    @id @default(uuid()) @db.Uuid
  user_id     String    @db.Uuid
  status      String    @default("pending") // pending | approved | rejected
  target_plan String    @default("pro")
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  reviewed_at         DateTime? @db.Timestamptz(6)
  reviewed_by         String?   @db.Uuid
  razorpay_order_id   String?
  razorpay_payment_id String?
  amount              Int?
  user                User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([status])
}

/// Per-user UTC-day aggregates for Phase 4 (worker outcomes; submission counts use Job rows).
model UsageDaily {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  day        DateTime @db.Date
  completed  Int      @default(0)
  failed     Int      @default(0)
  dead       Int      @default(0)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, day])
  @@index([day])
}

model Queue {
  id                 String   @id @default(uuid()) @db.Uuid
  user_id            String   @db.Uuid
  name               String
  concurrency        Int      @default(2)
  rate_limit_per_min Int      @default(5)
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  user               User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  jobs               Job[]
}

model Job {
  id           String    @id @default(uuid()) @db.Uuid
  user_id      String    @db.Uuid
  queue_id     String    @db.Uuid
  bull_job_id  String?
  type         String // summarise | transcribe | generate | translate
  payload      Json
  status       String @default("pending") // pending | active | completed | failed | dead
  is_deleted   Boolean   @default(false)
  priority     Int       @default(1)
  attempts     Int       @default(0)
  max_attempts Int       @default(3)
  result       Json?
  error        String?
  started_at   DateTime? @db.Timestamptz(6)
  completed_at DateTime? @db.Timestamptz(6)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  user         User      @relation(fields: [user_id], references: [id])
  queue        Queue     @relation(fields: [queue_id], references: [id])
  logs         JobLog[]
}

model JobLog {
  id         String   @id @default(uuid()) @db.Uuid
  job_id     String   @db.Uuid
  level      String // info | warn | error
  message    String
  meta       Json?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  job        Job      @relation(fields: [job_id], references: [id], onDelete: Cascade)
}
